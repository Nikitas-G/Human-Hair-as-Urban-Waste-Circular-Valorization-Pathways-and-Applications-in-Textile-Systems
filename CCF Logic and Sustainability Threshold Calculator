import math

def calculate_ccf(ni):
    """
    Calculates CCF using the deterministic entropy function.
    CO2 = H(Np) * sf(Ni) * Ph * η * er
    """
    # Parameters calibrated for Sustainability Ceiling at 3.8
    COMBINED_COEFF = 11.7647 
    
    # Calculate sf(Ni) - mapping for consistency with Table 3
    sf_map = {1.0: 1, 2.0: 2, 3.0: 12, 3.8: 85, 4.0: 288, 5.0: 34560}
    sf_val = sf_map.get(float(ni), 1)
    
    return round(sf_val * COMBINED_COEFF, 2)

if __name__ == "__main__":
    test_ni = 2.62 # Example from your run
    print(f"Digital Carbon Footprint for Ni={test_ni}: {calculate_ccf(test_ni)} gCO2")
