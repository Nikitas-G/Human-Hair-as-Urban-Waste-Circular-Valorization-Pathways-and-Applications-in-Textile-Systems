import math

# Model parameters derived from Section 2.3
# ph_eta_er: Combined coefficient (Hardware Power * Computational Efficiency * Regional Emission Factor)
ph_eta_er = 0.5  
# benefit: Fixed environmental dividend from hair recovery (1000 gCO2 offset)
benefit = 1000 

def calculate_ccf(ni):
    """
    Calculates the Computational Carbon Footprint (CCF) based on algorithmic intensity (Ni).
    Incorporates the superfactorial (sf) operator to model non-linear energy growth.
    """
    # sf(n) = 1! * 2! * ... * n!
    sf = 1
    for i in range(1, int(ni) + 1):
        sf *= math.factorial(i)
    
    # Core CCF Equation: Calculates carbon liabilities as a function of sf(Ni)
    ccf = sf * ph_eta_er * (ni**2)
    return ccf

# Defined Algorithmic Intensities (Ni) for sensitivity analysis
intensities = [1, 2, 3, 3.8, 4, 5]

print(f"{'Intensity (Ni)':<15} | {'Raw CCF Output (gCO2)':<25} | {'Sustainability Status'}")
print("-" * 70)

for ni in intensities:
    # Use floor for sf calculation; Ni=3.8 is approximated at level 3 for sensitivity
    res = calculate_ccf(math.floor(ni) if ni != 3.8 else 3) 
    
    # Comparative logic: Is the digital cost lower than the physical benefit?
    status = "SUSTAINABLE" if res < benefit else "NET LOSS (Ceiling Breached)"
    print(f"{ni:<15} | {res:<25.2f} | {status}")
