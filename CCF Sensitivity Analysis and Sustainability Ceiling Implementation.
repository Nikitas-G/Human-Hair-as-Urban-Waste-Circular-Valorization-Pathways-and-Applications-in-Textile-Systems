import matplotlib.pyplot as plt

def plot_sensitivity():
    # Data points derived from the CCF sensitivity model
    ni_values = [1.0, 2.0, 3.0, 3.8, 4.0, 5.0]
    # CCF values incorporating superfactorial growth, smoothed at Ni=5.0
    ccf_values = [11.76, 23.53, 141.18, 1000.0, 3388.23, 4500.0] 
    # Static mitigation reference value
    physical_benefit = [1000] * len(ni_values)

    plt.figure(figsize=(10, 6), dpi=300) # High-resolution for publication
    
    # Plotting with proper LaTeX formatting for subscripts
    plt.plot(ni_values, ccf_values, label=r'Digital Carbon Footprint ($CCF$)', 
             marker='o', linewidth=2, color='#1f77b4')
    plt.axhline(y=1000, color='#ff7f0e', linestyle='--', 
                label=r'Physical Benefit (1000 $gCO_2$)')
    
    # Scientific annotation of the Sustainability Ceiling
    plt.annotate(r'Sustainability Ceiling ($N_i \approx 3.8$)', 
                 xy=(3.8, 1000), xytext=(1.5, 3000),
                 fontsize=11, fontweight='bold',
                 arrowprops=dict(facecolor='black', shrink=0.05, width=1.5))
    
    # Axis labels using LaTeX for subscripts
    plt.xlabel(r'Algorithmic Intensity ($N_i$)', fontsize=12)
    plt.ylabel(r'Carbon Impact ($gCO_2$)', fontsize=12)
    
    plt.title('Sensitivity Analysis: Identification of Sustainability Ceiling', 
              fontsize=14, fontweight='bold', pad=15)
    
    plt.legend(loc='upper left', frameon=True)
    plt.grid(True, linestyle=':', alpha=0.7)
    
    # Save as high-quality PNG for MDPI submission
    plt.savefig('Figure_3_Sustainability_Ceiling.png', bbox_inches='tight')
    plt.show()

if __name__ == "__main__":
    plot_sensitivity()
